#!/usr/bin/env bash
# pre-push: refuse to publish a go.mod that only builds on one machine.
#
# A `replace => ../sibling` is a LOCAL development convenience. Pushed, it is a
# broken build for everyone else: CI has no sibling checkout, and an absolute
# path like /home/someone/src/... cannot resolve anywhere but the laptop it was
# written on. The override belongs in go.work, which is gitignored (see
# scripts/dev-setup.sh).
#
# Two tiers, deliberately:
#   ABSOLUTE (=> /...)   always refused. There is no reading under which a
#                        machine-specific path is correct in a shared repo.
#   RELATIVE (=> ../...) refused unless the module is listed in .replace-allow,
#                        which exists so a module that has NOT been migrated yet
#                        is an explicit, reviewable line rather than a silent
#                        exception. Every entry there is debt with a name.
#
# Checks the go.mod of each commit being PUSHED, not the working tree — the
# working tree is where the replace legitimately lives while you develop.
#
# Bypass with --no-verify when you genuinely mean it.
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
allow_file="$repo_root/.replace-allow"

fail=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	# All-zero local sha = branch deletion; nothing to inspect.
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac

	gomod=$(git show "$local_sha:go.mod" 2>/dev/null) || continue

	offenders=$(printf '%s\n' "$gomod" | awk -v allow="$allow_file" '
		BEGIN {
			while ((getline line < allow) > 0) {
				sub(/#.*/, "", line); gsub(/[ \t]+/, "", line)
				if (line != "") ok[line] = 1
			}
		}
		# `replace (` ... `)` block form
		/^[ \t]*replace[ \t]*\(/ { inblock = 1; next }
		inblock && /^[ \t]*\)/    { inblock = 0; next }
		{
			line = $0
			sub(/\/\/.*/, "", line)
			if (inblock)                     { pair = line }
			else if (line ~ /^[ \t]*replace[ \t]/) { sub(/^[ \t]*replace[ \t]+/, "", line); pair = line }
			else                             { next }

			if (pair !~ /=>/) next
			split(pair, halves, "=>")
			mod = halves[1]; target = halves[2]
			gsub(/^[ \t]+|[ \t]+$/, "", mod); gsub(/^[ \t]+|[ \t]+$/, "", target)
			sub(/[ \t].*$/, "", mod)      # drop a version on the left side
			sub(/[ \t].*$/, "", target)   # drop a version on the right side

			if (target ~ /^\//)                       { print "ABSOLUTE\t" mod "\t" target }
			else if (target ~ /^\.\.?\//)             { if (!(mod in ok)) print "RELATIVE\t" mod "\t" target }
		}
	')

	[ -z "$offenders" ] && continue
	fail=1
	echo "pre-push: go.mod in $(git rev-parse --short "$local_sha") has local replace directives:" >&2
	printf '%s\n' "$offenders" | while IFS=$'\t' read -r kind mod target; do
		printf '  %-8s %s => %s\n' "$kind" "$mod" "$target" >&2
	done
done

if [ "$fail" -ne 0 ]; then
	cat >&2 <<'MSG'

An ABSOLUTE replace never belongs in a pushed go.mod — it resolves on one machine.
A RELATIVE replace needs the module listed in .replace-allow (with a reason).

Fix, in order of preference:
  1. Move the override to go.work:  ./scripts/dev-setup.sh
     (go.work is gitignored, so the same build works locally without shipping it)
  2. Or, if the module has no publishable version yet, add it to .replace-allow.

Bypass once with: git push --no-verify
MSG
	exit 1
fi
exit 0
