node_modules/
*.tsbuildinfo

# dist holds a committed PLACEHOLDER bundle (index.html + assets/app.js) so the
# SPA tests run on a clean checkout; `make web` wipes it and replaces it with
# the real vite build, which must not re-commit over the placeholder. The two
# un-ignores keep the placeholder in git across that wipe — embed.go says why.
dist/*
!dist/.gitkeep
!dist/index.html
!dist/assets/
!dist/assets/app.js
