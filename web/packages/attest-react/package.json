{
  "name": "@iodesystems/attest-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless React bindings for the attest workbench. No styling, no design system.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iodesystems/attest-core": "file:../attest-core"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
